# Your HostGator MySQL database. In cPanel -> MySQL Databases, the full
# database name is usually prefixed with your cPanel username, e.g.
# "cpaneluser_djbrauer_menu_board" — check the "Current Databases" list if
# you're not sure of the exact name. You'll also need a MySQL user added to
# that database (cPanel -> MySQL Databases -> Add User to Database).
#
# Format: mysql://USER:PASSWORD@HOST:3306/DATABASE
DATABASE_URL="mysql://cpaneluser_dbuser:yourpassword@yourdomain.com:3306/cpaneluser_djbrauer_menu_board"

# Required by NextAuth to sign/encrypt session tokens.
# Generate one with: openssl rand -base64 32
NEXTAUTH_SECRET="replace-with-a-long-random-string"
NEXTAUTH_URL="http://localhost:3000"

# Google OAuth — create credentials at https://console.cloud.google.com/apis/credentials
# Authorized redirect URI: http://localhost:3000/api/auth/callback/google
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Facebook OAuth — create an app at https://developers.facebook.com/apps
# Valid OAuth Redirect URI: http://localhost:3000/api/auth/callback/facebook
FACEBOOK_CLIENT_ID=""
FACEBOOK_CLIENT_SECRET=""
